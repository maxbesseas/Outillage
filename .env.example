# Modèle de configuration de production. Copier les valeurs dans les variables d'environnement Vercel.
# Ne jamais versionner de vraies valeurs : le dépôt est public.

OUTILLAGE_ENV=prod
# python -c "import secrets; print(secrets.token_urlsafe(64))"
OUTILLAGE_SECRET_KEY=
OUTILLAGE_PUBLIC_URL=https://votre-domaine.fr

# Base PostgreSQL : sslmode=require (ou verify-full) est obligatoire en production.
OUTILLAGE_DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/outillage?sslmode=require

# Mot de passe du premier compte admin, à changer à la première connexion. Inutile une fois le compte créé.
OUTILLAGE_ADMIN_PASSWORD=

# Stockage des fichiers compatible S3, compartiment privé.
OUTILLAGE_S3_BUCKET=
OUTILLAGE_S3_ENDPOINT=https://s3.fr-par.scw.cloud
OUTILLAGE_S3_REGION=fr-par
OUTILLAGE_S3_ACCESS_KEY=
OUTILLAGE_S3_SECRET_KEY=

# Clé du cron : Vercel l'envoie à /cron/tick en en-tête Authorization.
CRON_SECRET=

# Assistant IA : laisser ANTHROPIC_API_KEY absente pour le garder désactivé (aucune donnée envoyée).
